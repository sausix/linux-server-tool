# Complete configuration reference; every value matches its context default.
# A deployment .env only needs overrides. Blank optional values mean unset.
# Missing files and unchanged examples produce the same effective settings.
# Production still requires a unique FRONTEND_SECRET_KEY; no shared secret is supplied.
# JSON lists use JSON syntax. Paths must be reachable in the process/container.

BACKEND_ENV_PREFIX=BACKEND_

# Shared component switches
DOCKER_SUPPORT=true
NETWORK_SUPPORT=true
SYSTEM_SUPPORT=true

# Backend: Listener, authentication and logging
BACKEND_TRANSPORT=unix
BACKEND_UNIX_SOCKET=/run/lsdfm/backend.sock
BACKEND_SOCKET_MODE=0660
BACKEND_LISTEN_HOST=127.0.0.1
BACKEND_LISTEN_PORT=9876
BACKEND_ACCESS_TOKEN=
BACKEND_MAX_CLIENTS=64
BACKEND_LOG_LEVEL=INFO

# Backend: Component access
BACKEND_DOCKER_ACCESS=readonly
BACKEND_NETWORK_ACCESS=readonly
BACKEND_SYSTEM_ACCESS=readonly

# Backend: Host mapping and per-feature access
BACKEND_SYSTEM_HOST_ROOT=
BACKEND_INTERFACES_ACCESS=rw
BACKEND_ROUTING_ACCESS=rw
BACKEND_FIREWALL_ACCESS=ro
BACKEND_FIREWALL_BACKEND=auto
BACKEND_SYSCTL_ACCESS=ro

# Backend: Docker Engine
BACKEND_DOCKER_ENDPOINT=unix:///var/run/docker.sock
BACKEND_DOCKER_TIMEOUT_SECONDS=5.0
BACKEND_DOCKER_STORAGE_TIMEOUT_SECONDS=30.0

# Backend: Docker logs
BACKEND_DOCKER_LOG_MAX_LINES=5000
BACKEND_DOCKER_LOG_DEFAULT_LINES=200
BACKEND_DOCKER_LOG_MAX_STREAMS=32
BACKEND_DOCKER_LOG_DISCOVERY_INTERVAL_SECONDS=2.0

# Backend: Docker API and TLS
BACKEND_DOCKER_API_VERSION=auto
BACKEND_DOCKER_TLS_VERIFY=true
BACKEND_DOCKER_TLS_CA=
BACKEND_DOCKER_TLS_CERT=
BACKEND_DOCKER_TLS_KEY=

# Backend: Compose definitions, sources and lifecycle
BACKEND_STACK_DATABASE=/var/lib/lsdfm/backend/stacks.sqlite3
BACKEND_COMPOSE_HOST_ROOT=/
BACKEND_COMPOSE_HOST_READ_ONLY=true
BACKEND_COMPOSE_ROOT=/var/lib/lsdfm/compose
BACKEND_COMPOSE_ALLOWED_ROOTS='["/srv","/opt","/home","/media","/app"]'
BACKEND_COMPOSE_SEARCH_DIRECTORIES=[]
BACKEND_COMPOSE_COMMAND='["docker","compose"]'
BACKEND_STACK_CONTROL_TIMEOUT_SECONDS=120
BACKEND_STACK_MAX_CONCURRENT_JOBS=2
BACKEND_STACK_STOP_TIMEOUT_SECONDS=10

# Backend: Persistent Linux configuration and command limits
BACKEND_NETWORKD_DIRECTORY=/etc/systemd/network
BACKEND_INTERFACES_FILE=/etc/network/interfaces
BACKEND_HOST_ETC_DIRECTORY=/etc
BACKEND_COMMAND_TIMEOUT_SECONDS=15.0

# Backend: Event subscriptions
BACKEND_EVENTS_ENABLED=true
