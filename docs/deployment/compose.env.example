# Complete configuration reference; every value matches its context default.
# A deployment .env only needs overrides. Blank optional values mean unset.
# Missing files and unchanged examples produce the same effective settings.
# Production still requires a unique FRONTEND_SECRET_KEY; no shared secret is supplied.
# JSON lists use JSON syntax. Paths must be reachable in the process/container.

FRONTEND_ENV_PREFIX=FRONTEND_
BACKEND_ENV_PREFIX=BACKEND_

# Shared component switches
DOCKER_SUPPORT=true
NETWORK_SUPPORT=true
SYSTEM_SUPPORT=true

# Frontend: Identity, runtime and database
FRONTEND_APP_NAME=
FRONTEND_ENVIRONMENT=production
FRONTEND_BIND_HOST=0.0.0.0
FRONTEND_PORT=8000
FRONTEND_PUBLIC_URL=http://localhost:8000
FRONTEND_DATABASE_URL=sqlite:////frontend/data/frontend.db
FRONTEND_SECRET_KEY=

# Frontend: Sessions
FRONTEND_SESSION_MAX_AGE_SECONDS=3600
FRONTEND_SESSION_PERSISTENT=true
FRONTEND_SESSION_ABSOLUTE_MAX_AGE_SECONDS=43200

# Frontend: Login policy and WebAuthn
FRONTEND_LOGIN_ALLOWED_NETWORKS=[]
FRONTEND_LOGIN_RULES=[]
FRONTEND_WEBAUTHN_MODE=optional
FRONTEND_LOGIN_FAILURE_LIMIT=5
FRONTEND_LOGIN_IP_FAILURE_LIMIT=20
FRONTEND_LOGIN_FAILURE_WINDOW_SECONDS=900
FRONTEND_LOGIN_BLOCK_SECONDS=300
FRONTEND_LOGIN_MAX_CONCURRENCY=4
FRONTEND_LOGIN_IPV6_PREFIX=64

# Frontend: Request and upload limits
FRONTEND_REQUEST_MAX_BYTES=8388608
FRONTEND_POST_MAX_BYTES=4194304
FRONTEND_LOGIN_MAX_BYTES=16384
FRONTEND_UPLOAD_MAX_BYTES=4194304
FRONTEND_UPLOAD_MAX_FILES=64

# Frontend: Password policy
FRONTEND_PASSWORD_MAX_AGE_DAYS=90

# Frontend: HTTPS, cookies and reverse proxy
FRONTEND_HTTP_POLICY=allow
FRONTEND_COOKIE_SECURE=auto
FRONTEND_TRUSTED_HOSTS=localhost,127.0.0.1
FRONTEND_FORWARDED_ALLOW_IPS=127.0.0.1
FRONTEND_SSL_CERTFILE=
FRONTEND_SSL_KEYFILE=

# Frontend: Daemon connection
FRONTEND_DAEMON_ENDPOINT=unix:///run/lsdfm/backend.sock
FRONTEND_DAEMON_TOKEN=
FRONTEND_DAEMON_TIMEOUT_SECONDS=1.0
FRONTEND_DAEMON_INVENTORY_TIMEOUT_SECONDS=15.0
FRONTEND_DAEMON_STORAGE_TIMEOUT_SECONDS=45.0
FRONTEND_DAEMON_CONTROL_TIMEOUT_SECONDS=150.0

# Frontend: Shutdown
FRONTEND_SHUTDOWN_TIMEOUT_SECONDS=10

# Backend: Listener, authentication and logging
BACKEND_TRANSPORT=unix
BACKEND_UNIX_SOCKET=/run/lsdfm/backend.sock
BACKEND_SOCKET_MODE=0660
BACKEND_LISTEN_HOST=127.0.0.1
BACKEND_LISTEN_PORT=9876
BACKEND_ACCESS_TOKEN=
BACKEND_MAX_CLIENTS=64
BACKEND_LOG_LEVEL=INFO

# Backend: Component access
BACKEND_DOCKER_ACCESS=readonly
BACKEND_NETWORK_ACCESS=readonly
BACKEND_SYSTEM_ACCESS=readonly

# Backend: Host mapping and per-feature access
BACKEND_SYSTEM_HOST_ROOT=/host/root
BACKEND_INTERFACES_ACCESS=rw
BACKEND_ROUTING_ACCESS=rw
BACKEND_FIREWALL_ACCESS=ro
BACKEND_FIREWALL_BACKEND=auto
BACKEND_SYSCTL_ACCESS=ro

# Backend: Docker Engine
BACKEND_DOCKER_ENDPOINT=unix:///run/docker.sock
BACKEND_DOCKER_TIMEOUT_SECONDS=5.0
BACKEND_DOCKER_STORAGE_TIMEOUT_SECONDS=30.0

# Backend: Docker logs
BACKEND_DOCKER_LOG_MAX_LINES=5000
BACKEND_DOCKER_LOG_DEFAULT_LINES=200
BACKEND_DOCKER_LOG_MAX_STREAMS=32
BACKEND_DOCKER_LOG_DISCOVERY_INTERVAL_SECONDS=2.0

# Backend: Docker API and TLS
BACKEND_DOCKER_API_VERSION=auto
BACKEND_DOCKER_TLS_VERIFY=true
BACKEND_DOCKER_TLS_CA=
BACKEND_DOCKER_TLS_CERT=
BACKEND_DOCKER_TLS_KEY=

# Backend: Compose definitions, sources and lifecycle
BACKEND_STACK_DATABASE=/var/lib/lsdfm/backend/stacks.sqlite3
BACKEND_COMPOSE_HOST_ROOT=/
BACKEND_COMPOSE_HOST_READ_ONLY=true
BACKEND_COMPOSE_ROOT=/var/lib/lsdfm/compose
BACKEND_COMPOSE_ALLOWED_ROOTS='["/srv","/opt","/home","/media","/app"]'
BACKEND_COMPOSE_SEARCH_DIRECTORIES=[]
BACKEND_COMPOSE_COMMAND='["docker","compose"]'
BACKEND_STACK_CONTROL_TIMEOUT_SECONDS=120
BACKEND_STACK_MAX_CONCURRENT_JOBS=2
BACKEND_STACK_STOP_TIMEOUT_SECONDS=10

# Backend: Persistent Linux configuration and command limits
BACKEND_NETWORKD_DIRECTORY=/host/etc/systemd/network
BACKEND_INTERFACES_FILE=/host/etc/network/interfaces
BACKEND_HOST_ETC_DIRECTORY=/host/etc
BACKEND_COMMAND_TIMEOUT_SECONDS=15.0

# Backend: Event subscriptions
BACKEND_EVENTS_ENABLED=true

# Compose-only inputs (not application Settings).
# Empty volume selectors use <Compose project>_frontend-data / _backend-state.
# Set COMPOSE_PROJECT_NAME explicitly only when choosing a project name.
# COMPOSE_PROJECT_NAME=your-deployment
APPLICATION_IMAGE=application:local
FRONTEND_PUBLISHED_BIND=127.0.0.1
FRONTEND_PUBLISHED_PORT=8000
FRONTEND_DATA_VOLUME=
BACKEND_STATE_VOLUME=
BACKEND_SOCKET_GID=2000
BACKEND_RUN_DIRECTORY=./lsdfm-run
BACKEND_DOCKER_SOCKET_PATH=/run/docker.sock
BACKEND_HOST_FILESYSTEM_ROOT=/
