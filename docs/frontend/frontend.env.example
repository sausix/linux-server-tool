# Complete configuration reference; every value matches its context default.
# A deployment .env only needs overrides. Blank optional values mean unset.
# Missing files and unchanged examples produce the same effective settings.
# Production still requires a unique FRONTEND_SECRET_KEY; no shared secret is supplied.
# JSON lists use JSON syntax. Paths must be reachable in the process/container.

FRONTEND_ENV_PREFIX=FRONTEND_

# Shared component switches
DOCKER_SUPPORT=true
NETWORK_SUPPORT=true
SYSTEM_SUPPORT=true

# Frontend: Identity, runtime and database
FRONTEND_APP_NAME=LSDFM
FRONTEND_ENVIRONMENT=development
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8000
FRONTEND_PUBLIC_URL=http://localhost:8000
FRONTEND_DATABASE_URL=sqlite:///./data/frontend.db
FRONTEND_SECRET_KEY=

# Frontend: Sessions
FRONTEND_SESSION_MAX_AGE_SECONDS=3600
FRONTEND_SESSION_PERSISTENT=true
FRONTEND_SESSION_ABSOLUTE_MAX_AGE_SECONDS=43200

# Frontend: Login policy and WebAuthn
FRONTEND_LOGIN_ALLOWED_NETWORKS=[]
FRONTEND_LOGIN_RULES=[]
FRONTEND_WEBAUTHN_MODE=optional
FRONTEND_LOGIN_FAILURE_LIMIT=5
FRONTEND_LOGIN_IP_FAILURE_LIMIT=20
FRONTEND_LOGIN_FAILURE_WINDOW_SECONDS=900
FRONTEND_LOGIN_BLOCK_SECONDS=300
FRONTEND_LOGIN_MAX_CONCURRENCY=4
FRONTEND_LOGIN_IPV6_PREFIX=64

# Frontend: Request and upload limits
FRONTEND_REQUEST_MAX_BYTES=8388608
FRONTEND_POST_MAX_BYTES=4194304
FRONTEND_LOGIN_MAX_BYTES=16384
FRONTEND_UPLOAD_MAX_BYTES=4194304
FRONTEND_UPLOAD_MAX_FILES=64

# Frontend: Password policy
FRONTEND_PASSWORD_MAX_AGE_DAYS=90

# Frontend: HTTPS, cookies and reverse proxy
FRONTEND_HTTP_POLICY=allow
FRONTEND_COOKIE_SECURE=auto
FRONTEND_TRUSTED_HOSTS=localhost,127.0.0.1
FRONTEND_FORWARDED_ALLOW_IPS=127.0.0.1
FRONTEND_SSL_CERTFILE=
FRONTEND_SSL_KEYFILE=

# Frontend: Daemon connection
FRONTEND_DAEMON_ENDPOINT=unix:///run/lsdfm/backend.sock
FRONTEND_DAEMON_TOKEN=
FRONTEND_DAEMON_TIMEOUT_SECONDS=1.0
FRONTEND_DAEMON_INVENTORY_TIMEOUT_SECONDS=15.0
FRONTEND_DAEMON_STORAGE_TIMEOUT_SECONDS=45.0
FRONTEND_DAEMON_CONTROL_TIMEOUT_SECONDS=150.0

# Frontend: Shutdown
FRONTEND_SHUTDOWN_TIMEOUT_SECONDS=10
